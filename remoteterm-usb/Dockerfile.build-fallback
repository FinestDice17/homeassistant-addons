# On-device build fallback. Rename to `Dockerfile` and remove the `image:` line from config.yaml.
# Upstream: https://github.com/statico/remoteterm-meshcore (continuation of the paused
# jkingsman/Remote-Terminal-for-MeshCore project).
# Keep REMOTETERM_VERSION in step with `version:` in config.yaml.
ARG REMOTETERM_VERSION=3.26.9
FROM ghcr.io/statico/remoteterm-meshcore:${REMOTETERM_VERSION}

# Install jq (options parsing) and curl (Supervisor API + REST bootstrap)
RUN apt-get update \
    && apt-get install -y --no-install-recommends jq curl \
    && rm -rf /var/lib/apt/lists/*

COPY run.sh /run.sh
RUN chmod a+x /run.sh

CMD ["/run.sh"]
